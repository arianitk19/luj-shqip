# Public values only — everything prefixed VITE_ is embedded in the browser bundle.
VITE_API_URL=http://localhost:2567
# Production auth (Supabase). Use the *anon* key only — never the service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Local development only: passwordless login against the server's DEV_AUTH endpoint.
VITE_DEV_AUTH=0
