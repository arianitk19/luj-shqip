NODE_ENV=development
PORT=2567
HOST=0.0.0.0
LOG_LEVEL=info
# Set to 1 ONLY behind a trusted reverse proxy (so client IPs / rate limits are correct).
TRUST_PROXY=0

DATABASE_URL=postgres://postgres@127.0.0.1:5432/lujshqip
DATABASE_POOL_MAX=10

# Comma-separated browser origins allowed to call the API and open WebSockets. No wildcards in production.
ALLOWED_ORIGINS=http://localhost:5173

# --- Production auth: Supabase JWT verification (JWKS) ---
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated

# --- Local development ONLY (refused when NODE_ENV=production) ---
DEV_AUTH=0
DEV_AUTH_SECRET=

TURN_TIMEOUT_SECONDS=60
RECONNECT_GRACE_SECONDS=60
PRIVATE_ROOM_IDLE_MINUTES=15
