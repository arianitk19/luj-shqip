{
  "name": "@lujshqip/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/cli.ts up",
    "db:status": "tsx --env-file-if-exists=.env src/db/cli.ts status",
    "db:rollback": "tsx --env-file-if-exists=.env src/db/cli.ts down"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.18",
    "@colyseus/schema": "^5.0.40",
    "@colyseus/ws-transport": "^0.18.4",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@lujshqip/game-contracts": "workspace:*",
    "@lujshqip/game-pishpirik": "workspace:*",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.5",
    "@types/pg": "^8.18.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "ws": "^8.22.0",
    "@types/ws": "^8.18.1"
  }
}
